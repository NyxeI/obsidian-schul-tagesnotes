{
  "name": "obsidian-schul-tagesnotes",
  "version": "0.4.0",
  "description": "Daily class notes per subject, filed automatically by subject, term and topic, with hub overviews built on Bases.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --import ./tests/support/register.ts --test \"tests/*.test.ts\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin"
  ],
  "author": "Nyxel",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.13.1",
    "tslib": "^2.8.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/schildi208-lgtm/obsidian-schul-tagesnotes.git"
  }
}
