{
  "name": "obsidian-schul-tagesnotes",
  "version": "0.1.0",
  "description": "Tagesnotes pro Fach anlegen und automatisch nach Fach / Halbjahr / Thema einsortieren.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --import ./tests/support/register.ts --test \"tests/*.test.ts\""
  },
  "keywords": ["obsidian", "obsidian-plugin"],
  "author": "Nyxel",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.8.0"
  }
}
